# JevK5 TypeSafe Server Configuration Example

# URL of the backend llama-server running JevK5 GGUF
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Advertised model identifier
MODEL_NAME=jevk5-4b-v0.3-Q8_0

# Temperature calibration for <= 16 options
TEMPERATURE=1.22

# Knockout tournament calibration temperature for > 16 options
KNOCKOUT_TEMPERATURE=0.93

# Number of top logprobs to request from llama-server
TOP_K=40

# Request timeout in seconds
TIMEOUT_S=120.0

# Optional API Key for Bearer authentication (leave commented out to disable auth)
# API_KEY=sk-your-secret-api-key

# Server binding host and port (when running directly via Python/uv)
HOST=0.0.0.0
PORT=8000

# Docker Compose host port mapping (maps $HOST_PORT on host -> 8000 in container)
HOST_PORT=8000

# Backend llama-server parameters (used by Docker Compose)
# Repository and GGUF file from huggingface.co/alibiserikbay/JevK5-GGUF
HF_REPO=alibiserikbay/JevK5-GGUF
HF_FILE=jevk5-4b-v0.3-Q8_0.gguf
CTX_SIZE=8192
# Number of layers to offload to GPU (set to 0 for pure CPU mode)
NGL=99
